# Database
DATABASE_URL=

# Server
PORT=3001
NODE_ENV=development
# Évaluation périodique des alertes opérationnelles (ms) ; 0 pour désactiver
SUPERVISION_ALERT_EVAL_INTERVAL_MS=120000

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Admin (required for admin sign-in; not exposed on public register)
ADMIN_EMAIL=admin@chu.ma
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Fatima
ADMIN_LAST_NAME=Admin

# AI / NVIDIA NIM — le chef active le service depuis le dashboard (Mode IA)
# AI_ENABLED=true force l'infra active ; sinon clé + AI_CHIEF_CAN_ENABLE suffisent
AI_ENABLED=false
AI_CHIEF_CAN_ENABLE=true
# Plafond maximal : collaborative | supervised_autonomy | full_control_simulation
# (pas "enabled" — utiliser collaborative ; le mode actif se règle dans le dashboard chef)
AI_MODE=collaborative
# Coupure d'urgence ops (prioritaire sur le dashboard chef)
# AI_OPS_KILL_SWITCH=false
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
AI_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_REASONING_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1
